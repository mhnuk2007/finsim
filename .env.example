# ==============================================================================
# FinSim Production Environment Variables (.env)
# Copy to .env and customize before starting: docker compose -f docker-compose.prod.yml up -d
# ==============================================================================

# PostgreSQL credentials
POSTGRES_DB=finsim
POSTGRES_USER=finsim
# Generate a strong password (e.g., using `openssl rand -hex 24`)
POSTGRES_PASSWORD=replace_with_a_secure_generated_password

# Domain or public IP for Caddy automated TLS reverse proxy
# If using a custom domain (e.g. finsim.example.com), Caddy automatically acquires Let's Encrypt TLS.
# If testing with an IP or localhost, set DOMAIN_NAME=:80 or localhost
DOMAIN_NAME=localhost

# Allowed CORS origins for external frontend (e.g., Vercel deployment or local Next.js)
# Comma-separated list of origins. Leave empty if no web frontend needs cross-origin access.
FINSIM_CORS_ALLOWED_ORIGINS=https://finsim.vercel.app,http://localhost:3000

# Registry SSRF policy (defaults to false in prod to block private RFC 1918 addresses)
FINSIM_REGISTRY_ALLOW_PRIVATE_ADDRESSES=false
# Comma-separated internal service hostnames permitted when allow-private-addresses=false
FINSIM_REGISTRY_INTERNAL_HOSTS=bank-a,bank-b

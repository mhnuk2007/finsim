# Default cockpit mode: "demo" (zero-backend browser simulator) or "live" (finsim-api)
VITE_DEFAULT_MODE=demo

# Leave empty when using Vite dev proxy or same-origin Caddy reverse proxy.
# Set to your Oracle Cloud Caddy gateway URL (e.g. https://api.finsim.dev) for cross-origin deployments
# (ensure that origin is listed in FINSIM_CORS_ALLOWED_ORIGINS on finsim-api).
VITE_API_BASE_URL=
